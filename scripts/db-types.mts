import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import path from "node:path";

const outputPath = new URL("../backend/db/rows.ts", import.meta.url);
const check = process.argv.includes("--check");

interface TableInfo {
  name: string;
  sql: string;
  strict: number;
  wr: number;
}
interface ColumnInfo {
  name: string;
  type: string;
  notnull: number;
  pk: number;
  hidden: number;
}

const HIDDEN_VIRTUAL_TABLE_COLUMN = 1;

const dataDir = mkdtempSync(path.join(tmpdir(), "aurral-db-types-"));
process.env.AURRAL_DATA_DIR = dataDir;
process.env.AURRAL_DB_PATH = path.join(dataDir, "aurral.db");

let output = "";
try {
  output = await generate();
} finally {
  rmSync(dataDir, { recursive: true, force: true });
}

if (check) {
  let current = "";
  try {
    current = readFileSync(outputPath, "utf8");
  } catch {}
  if (current !== output) {
    console.error("backend/db/rows.ts does not match the schema. Run `npm run db:types`.");
    process.exit(1);
  }
} else {
  writeFileSync(outputPath, output);
  console.log("Wrote backend/db/rows.ts.");
}

async function generate() {
  const { db } = await import("../backend/config/db-sqlite.ts");
  await import("../backend/services/metadataProviderBudget.ts");
  const { getHonkerDb, closeHonkerDb } = await import("../backend/services/honkerDb.ts");
  getHonkerDb();
  closeHonkerDb();
  try {
    return render(db);
  } finally {
    db.close();
  }
}

function render(db: import("better-sqlite3").Database) {
  const tables = db
    .prepare<[], TableInfo>(
      `SELECT m.name, m.sql, t.strict, t.wr
       FROM sqlite_master m JOIN pragma_table_list t ON t.name = m.name AND t.schema = 'main'
       WHERE m.type = 'table' AND m.name NOT LIKE 'sqlite_%' ORDER BY m.name`,
    )
    .all();
  const virtualTables = tables.filter((table) => /VIRTUAL TABLE/i.test(table.sql));
  const columnsOf = (table: string) =>
    db
      .prepare<[string], ColumnInfo>("SELECT * FROM pragma_table_xinfo(?)")
      .all(table)
      .filter((column) => column.hidden !== HIDDEN_VIRTUAL_TABLE_COLUMN);

  const blocks = tables
    .filter((table) => !virtualTables.some((v) => table.name.startsWith(`${v.name}_`)))
    .map((table) => {
      const contentTable = /\bcontent\s*=\s*'([^']+)'/i.exec(table.sql)?.[1];
      const contentColumns = contentTable ? columnsOf(contentTable) : [];
      const columns = columnsOf(table.name);
      const fields = columns.map((column) => {
        const source = contentColumns.find((c) => c.name === column.name);
        const type = source
          ? tsType(
              source,
              tables.find((t) => t.name === contentTable),
              columns,
            )
          : /VIRTUAL TABLE/i.test(table.sql)
            ? "unknown"
            : tsType(column, table, columns);
        return `  ${column.name}: ${type};`;
      });
      return `export interface ${pascal(table.name)}Row {\n${fields.join("\n")}\n}`;
    });

  return `// Generated by scripts/db-types.mts from the SQLite schema. Run \`npm run db:types\` after a schema change.\n\n${blocks.join("\n\n")}\n`;
}

function tsType(column: ColumnInfo, table: TableInfo | undefined, siblings: ColumnInfo[]) {
  const declared = column.type.toUpperCase();
  let type = "unknown";
  if (declared.includes("INT")) type = "number";
  else if (declared.includes("CHAR") || declared.includes("CLOB") || declared.includes("TEXT")) {
    type = "string";
  } else if (declared.includes("BLOB")) type = "Buffer";
  else if (declared.includes("REAL") || declared.includes("FLOA") || declared.includes("DOUB")) {
    type = "number";
  } else if (declared.includes("NUM") || declared.includes("DEC") || declared.includes("BOOL")) {
    type = "number";
  }
  const rowidAlias =
    declared === "INTEGER" && column.pk === 1 && siblings.filter((c) => c.pk > 0).length === 1;
  const keyRejectsNull = column.pk > 0 && (table?.strict === 1 || table?.wr === 1);
  const nullable = column.notnull === 0 && !rowidAlias && !keyRejectsNull;
  return nullable && type !== "unknown" ? `${type} | null` : type;
}

function pascal(name: string) {
  return name.replace(/(^|_)([a-z0-9])/gi, (_match, _sep, letter: string) => letter.toUpperCase());
}
