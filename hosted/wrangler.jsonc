{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurral-music",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "music.aurral.org", "custom_domain": true }],
  "assets": { "directory": "site", "not_found_handling": "single-page-application" },
}
