{
  "name": "aurral",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted music discovery and library management.",
  "keywords": [
    "lidarr",
    "music",
    "musicbrainz",
    "request"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter aurral-frontend run build",
    "start": "node --max-semi-space-size=4 --env-file=backend/.env backend/server.ts",
    "check": "vp check && node frontend/scripts/lint-ui-css.mts && node scripts/db-types.mts --check && node scripts/typecheck.mts",
    "lint": "vp lint && node frontend/scripts/lint-ui-css.mts",
    "typecheck": "node scripts/typecheck.mts",
    "lint:ui": "node frontend/scripts/lint-ui-css.mts && vp lint frontend/src",
    "format": "vp fmt",
    "test": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "test:browser": "playwright install chromium && vp test run --project browser",
    "test:e2e": "playwright install chromium && playwright test",
    "perf:library": "node scripts/benchmark-library.mts",
    "dev": "node scripts/dev.mts",
    "wait-and-dev:frontend": "while ! curl -s http://localhost:3001/api/health; do sleep 1; done && pnpm --filter aurral-frontend run dev",
    "dev:backend": "node --watch --env-file=backend/.env backend/server.ts",
    "dev:frontend": "pnpm --filter aurral-frontend run dev",
    "auth:reset-admin-password": "pnpm --filter aurral-backend run auth:reset-admin-password",
    "docker:build": "docker build -t aurral .",
    "docker:run": "docker run -p 3001:3001 -v $(pwd)/backend/data:/app/backend/data aurral",
    "docs:dev": "pnpm --filter aurral-docs run dev",
    "docs:build": "pnpm --filter aurral-docs run build",
    "prepare": "vp config",
    "db:types": "node scripts/db-types.mts"
  },
  "dependencies": {
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@russellthehippo/honker-node": "^0.5.1",
    "@tanstack/react-query": "^5.104.3",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "5.0.5",
    "ajv": "^8.20.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "hono": "^4.13.13",
    "music-metadata": "^12.2.1",
    "node-taglib-sharp": "^6.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": "26.12.x"
  },
  "packageManager": "pnpm@12.15.0"
}
