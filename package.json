{
  "name": "aurral",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted music discovery and library management.",
  "keywords": [
    "lidarr",
    "music",
    "musicbrainz",
    "request"
  ],
  "license": "MIT",
  "author": "",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace frontend",
    "start": "node --env-file=backend/.env backend/server.ts",
    "check": "vp check && node frontend/scripts/lint-ui-css.mts && node scripts/db-types.mts --check && node scripts/typecheck.mts",
    "lint": "vp lint && node frontend/scripts/lint-ui-css.mts",
    "typecheck": "node scripts/typecheck.mts",
    "lint:ui": "node frontend/scripts/lint-ui-css.mts && vp lint frontend/src",
    "format": "vp fmt",
    "test": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "test:browser": "playwright install chromium && vp test run --project browser",
    "test:e2e": "playwright install chromium && playwright test",
    "perf:library": "node scripts/benchmark-library.mts",
    "dev": "node scripts/dev.mts",
    "wait-and-dev:frontend": "while ! curl -s http://localhost:3001/api/health; do sleep 1; done && npm run dev --workspace frontend",
    "dev:backend": "node --watch --env-file=backend/.env backend/server.ts",
    "dev:frontend": "npm run dev --workspace frontend",
    "auth:reset-admin-password": "npm run auth:reset-admin-password --workspace backend",
    "docker:build": "docker build -t aurral .",
    "docker:run": "docker run -p 3001:3001 -v $(pwd)/backend/data:/app/backend/data aurral",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "prepare": "vp config",
    "db:types": "node scripts/db-types.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "5.0.5",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "node-taglib-sharp": {
      "uuid": "^11.1.1"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "engines": {
    "node": "26.12.x"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true,
    "better-sqlite3": false
  }
}
