{
  "name": "aurral",
  "version": "2.0.0",
  "private": true,
  "description": "Find new music, get it, and play it, all on your own server.",
  "keywords": [
    "lidarr",
    "music",
    "musicbrainz",
    "request"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter aurral-frontend run build",
    "start": "node --max-semi-space-size=4 --env-file=backend/.env backend/server.ts",
    "check": "vp check && node frontend/scripts/lint-ui-css.mts && node scripts/db-types.mts --check && tsc -p . && node scripts/lint-any.mts",
    "lint": "vp lint && node frontend/scripts/lint-ui-css.mts",
    "typecheck": "tsc -p .",
    "lint:any": "node scripts/lint-any.mts",
    "lint:ui": "node frontend/scripts/lint-ui-css.mts && vp lint frontend/src",
    "format": "vp fmt",
    "test": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "perf": "node scripts/perf.mts",
    "perf:baseline": "node scripts/perf.mts baseline",
    "dev": "node scripts/dev.mts",
    "eden": "node eden/cli.ts",
    "dev:backend": "node --watch --env-file=backend/.env backend/server.ts",
    "dev:frontend": "pnpm --filter aurral-frontend run dev",
    "auth:reset-admin-password": "pnpm --filter aurral-backend run auth:reset-admin-password",
    "docker:build": "docker build -t aurral .",
    "docker:run": "docker run -p 3001:3001 -v $(pwd)/backend/data:/config aurral",
    "docs:dev": "pnpm --filter aurral-docs run dev",
    "docs:build": "pnpm --filter aurral-docs run build",
    "prepare": "vp config",
    "db:types": "node scripts/db-types.mts"
  },
  "dependencies": {
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/send": "^1.2.1",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "libxml2-wasm": "^0.7.2",
    "music-metadata": "^12.2.1",
    "node-taglib-sharp": "^6.0.3",
    "playwright-core": "1.64.1",
    "react": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": "26.12.x"
  },
  "packageManager": "pnpm@12.15.0"
}
