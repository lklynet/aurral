{
  "name": "aurral",
  "version": "2.0.0",
  "description": "Aurral artist request manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.x"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace frontend",
    "start": "node --env-file=backend/.env backend/server.js",
    "lint": "npm run lint:backend && npm run lint --workspace frontend",
    "lint:backend": "eslint backend lib --no-config-lookup --rule 'no-unused-vars:[error,{\"argsIgnorePattern\":\"^_\",\"caughtErrors\":\"none\",\"varsIgnorePattern\":\"^_\"}]'",
    "test": "node --test --import ./.tests/setup-env.js --test-concurrency=4 $(find .tests -name '*.test.js' -not -name '*.int.test.js' -print)",
    "test:integration": "node --test --import ./.tests/setup-env.js --test-concurrency=1 $(find .tests -name '*.int.test.js' -print)",
    "test:coverage": "node --experimental-test-coverage --test --import ./.tests/setup-env.js --test-concurrency=4 --test-coverage-include='backend/**' --test-coverage-lines=30 $(find .tests -name '*.test.js' -not -name '*.int.test.js' -print)",
    "perf:library": "node scripts/benchmark-library.mjs",
    "dev": "node scripts/dev.mjs",
    "wait-and-dev:frontend": "while ! curl -s http://localhost:3001/api/health; do sleep 1; done && npm run dev --workspace frontend",
    "dev:backend": "node --watch --env-file=backend/.env backend/server.js",
    "dev:frontend": "npm run dev --workspace frontend",
    "auth:reset-admin-password": "npm run auth:reset-admin-password --workspace backend",
    "docker:build": "docker build -t aurral .",
    "docker:run": "docker run -p 3001:3001 -v $(pwd)/backend/data:/app/backend/data aurral",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "site:generate:ascii-logo": "node scripts/video-to-ascii.mjs",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "prepare": "if [ -d .git ] && [ -f scripts/install-git-hooks.sh ]; then sh scripts/install-git-hooks.sh; fi"
  },
  "keywords": [
    "lidarr",
    "musicbrainz",
    "music",
    "request"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "brace-expansion": "5.0.9",
    "react-router": "8.3.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "better-sqlite3@12.10.0": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  }
}
