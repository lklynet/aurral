# Disposable values for local Aurral Labs. Labs listen only on 127.0.0.1.
# The seed creates this admin, and browser tests sign in with it.
AUTH_USER=lab-admin
AUTH_PASSWORD=disposable-lab-password
# Aurral's API key, which the simulated Lidarr uses for its import webhook.
AURRAL_LAB_API_KEY=disposable-aurral-lab-api-key-for-local-labs-only

# Simulated services in the Lab's fixtures container.
AURRAL_LAB_METADATA_URL=http://fixtures:8601
AURRAL_LAB_LIDARR_URL=http://fixtures:8686
AURRAL_LAB_LIDARR_API_KEY=disposable-lab-lidarr-key
AURRAL_LAB_SLSKD_URL=http://fixtures:5030
AURRAL_LAB_SLSKD_API_KEY=disposable-lab-slskd-key
AURRAL_LAB_PROWLARR_URL=http://fixtures:9696
AURRAL_LAB_PROWLARR_API_KEY=disposable-lab-prowlarr-key
AURRAL_LAB_SABNZBD_URL=http://fixtures:8080
AURRAL_LAB_SABNZBD_API_KEY=disposable-lab-sabnzbd-key
AURRAL_LAB_NZBGET_URL=http://fixtures:6789
AURRAL_LAB_NZBGET_USERNAME=lab-nzbget
AURRAL_LAB_NZBGET_PASSWORD=disposable-lab-nzbget-password
AURRAL_LAB_DEEMIX_URL=http://fixtures:6595
AURRAL_LAB_NAVIDROME_URL=http://fixtures:4533
AURRAL_LAB_NAVIDROME_USERNAME=lab-navidrome
AURRAL_LAB_NAVIDROME_PASSWORD=disposable-lab-navidrome-password
AURRAL_LAB_PLEX_URL=http://fixtures:32400
AURRAL_LAB_PLEX_TOKEN=disposable-lab-plex-token
AURRAL_LAB_PLEX_MACHINE_IDENTIFIER=aurral-lab-plex-server
AURRAL_LAB_JELLYFIN_URL=http://fixtures:8096
AURRAL_LAB_JELLYFIN_API_KEY=disposable-lab-jellyfin-key
AURRAL_LAB_KOITO_URL=http://fixtures:4110
AURRAL_LAB_KOITO_TOKEN=disposable-lab-koito-token
