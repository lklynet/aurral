{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurral-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "aurral.org/v1/*", "zone_name": "aurral.org" },
    { "pattern": "aurral.org/account*", "zone_name": "aurral.org" },
    { "pattern": "aurral.org/link*", "zone_name": "aurral.org" },
    { "pattern": "aurral.org/connect*", "zone_name": "aurral.org" },
  ],
  "vars": {
    "HUB_ORIGIN": "https://aurral.org",
    "APP_ORIGIN": "https://music.aurral.org",
    "CONNECT_DOMAIN": "aurral.dev",
    "CONNECT_RELAY_URL": "wss://relay.aurral.dev/tunnel",
    "POLAR_API_ORIGIN": "https://api.polar.sh",
    "POLAR_PRODUCT_MONTHLY_ID": "019d05db-a24e-4f44-a4d8-30e368ca6056",
    "POLAR_PRODUCT_YEARLY_ID": "53648334-59bc-4414-9b3a-e402c9b65af6",
    "POLAR_PORTAL_URL": "https://polar.sh/aurral/portal",
  },
  "ratelimits": [
    { "name": "LINK_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "680b1f6c-d759-4285-97ab-501d8a82a234",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": [],
      "vars": {
        "HUB_ORIGIN": "https://aurral-hub-preview.leefamous.workers.dev",
        "APP_ORIGIN": "https://music.aurral.org",
        "CONNECT_DOMAIN": "aurral.dev",
        "CONNECT_RELAY_URL": "wss://relay.aurral.dev/tunnel",
        "POLAR_API_ORIGIN": "https://sandbox-api.polar.sh",
        "POLAR_PRODUCT_MONTHLY_ID": "090271e1-5c76-4ced-a622-91922cfb1591",
        "POLAR_PRODUCT_YEARLY_ID": "23c302c6-b133-43f3-b58d-fcd95b703952",
        "POLAR_PORTAL_URL": "https://sandbox.polar.sh/factory-starter/portal",
      },
      "ratelimits": [
        { "name": "LINK_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
      ],
      "d1_databases": [
        { "binding": "DB", "database_name": "aurral-hub-preview", "migrations_dir": "migrations" },
      ],
    },
  },
}
