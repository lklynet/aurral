{
  "name": "aurral-backend",
  "version": "0.0.0",
  "description": "Self-hosted music discovery and library management.",
  "private": true,
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "test": "cd .. && npm test",
    "auth:reset-admin-password": "node --env-file=.env scripts/resetAdminPassword.js"
  },
  "keywords": [
    "musicbrainz",
    "music",
    "request"
  ],
  "author": "",
  "license": "MIT",
  "optionalDependencies": {
    "@russellthehippo/honker-node-darwin-arm64": "0.5.1",
    "@russellthehippo/honker-node-darwin-x64": "0.5.1",
    "@russellthehippo/honker-node-linux-arm64-gnu": "0.5.1",
    "@russellthehippo/honker-node-linux-x64-gnu": "0.5.1"
  },
  "dependencies": {
    "@rowanmanning/feed-parser": "^2.1.5",
    "@russellthehippo/honker-node": "^0.5.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.2",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^8.3.0",
    "html-entities": "^2.6.0",
    "music-metadata": "^11.16.1",
    "openid-client": "^6.8.8",
    "p-map": "^7.0.8",
    "p-queue": "^9.3.3",
    "sharp": "^0.35.5",
    "undici": "^8.11.2",
    "ws": "^8.22.0",
    "youtubei.js": "~18.1.0"
