{
  "name": "aurral-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted music discovery and library management.",
  "keywords": [
    "music",
    "musicbrainz",
    "request"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "node --max-semi-space-size=4 --env-file=.env server.ts",
    "dev": "node --watch --env-file=.env server.ts",
    "test": "pnpm --workspace-root test",
    "auth:reset-admin-password": "node --env-file=.env scripts/resetAdminPassword.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/standard-validator": "^0.4.0",
    "@rowanmanning/feed-parser": "^2.1.5",
    "@russellthehippo/honker-node": "^0.5.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "content-disposition": "^2.0.1",
    "fast-xml-parser": "^5.11.2",
    "fastest-levenshtein": "^1.0.16",
    "hono": "^4.13.13",
    "html-entities": "^2.6.0",
    "ipaddr.js": "^1.9.1",
    "music-metadata": "^12.2.1",
    "node-taglib-sharp": "^6.0.3",
    "openid-client": "^6.8.8",
    "p-map": "^7.1.1",
    "p-queue": "^10.0.0",
    "proxy-addr": "^2.0.8",
    "send": "^1.2.1",
    "sharp": "^0.35.5",
    "undici": "^8.12.2",
    "valibot": "^1.5.0",
    "ws": "^8.22.0",
    "youtubei.js": "~18.1.0"
  },
  "optionalDependencies": {
    "@russellthehippo/honker-node-darwin-arm64": "0.5.1",
    "@russellthehippo/honker-node-darwin-x64": "0.5.1",
    "@russellthehippo/honker-node-linux-arm64-gnu": "0.5.1",
    "@russellthehippo/honker-node-linux-x64-gnu": "0.5.1"
  }
}
